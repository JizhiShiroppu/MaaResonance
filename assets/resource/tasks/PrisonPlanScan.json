        "PrisonPlanReserveCoins": {
            "type": "select",
            "label": "铁盟币安全保留底线",
            "description": "账面资金低于此底线时停止消耗铁盟币的基建、扩仓与原料预存，避免影响跑商本金与日常周转；可选择自定义精确数额。",
