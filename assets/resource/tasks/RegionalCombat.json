{
    "task": [
        {
            "name": "RegionalCombat",
            "label": "区域作战中心自动作战",
            "entry": "RegionalCombatLoop",
            "description": "自动从列车大厅经「作战终端 -> 区域作战中心」进入（也可直接停在区域作战中心界面），默认优先清理关卡数少的短站点并逐城自动推进尚未首通的「威胁等级」新关卡；可按敌方等级上限避让高难关、限制推关次数或启用限次吃体力药。",
            "group": [
                "combat"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "RegionalCombatAutoEnterTerminal",
                "RegionalCombatScope",
                "RegionalCombatMaxEnemyLevel",
                "RegionalCombatMaxRuns",
                "RegionalCombatUseClarityMedicine",
                "RegionalCombatFormationMode",
                "RegionalCombatBattlePlayMode",
                "RegionalCombatPreferNativeAuto",
                "RegionalCombatLeaderSkill"
            ]
        }
    ],
    "option": {
        "RegionalCombatAutoEnterTerminal": {
            "type": "switch",
            "label": "自动从列车大厅进入区域作战中心",
            "description": "开启后（全自动推荐），若停在列车大厅、活动中心或铁安协同终端界面，会自动跳转进入「区域作战中心」再开始推关；关闭则仅在当前区域作战中心界面内运行。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "RegionalCombatLobbyEnterTerminal": {
                            "enabled": true
                        },
                        "RegionalCombatTerminalEnter": {
                            "enabled": true
                        },
                        "RegionalCombatActivityHubSwitch": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RegionalCombatLobbyEnterTerminal": {
                            "enabled": false
                        },
                        "RegionalCombatTerminalEnter": {
                            "enabled": false
                        },
                        "RegionalCombatActivityHubSwitch": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "RegionalCombatScope": {
            "type": "select",
            "label": "车站推进范围",
            "description": "决定当前车站推完或遇到高难关后的处理方式。",
            "default_case": "AllCities",
            "cases": [
                {
                    "name": "AllCities",
                    "label": "全车站自动推进（跳过 100% / 未解锁 / 超等级上限车站）",
                    "option": [
                        "RegionalCombatCityOrder"
                    ],
                    "pipeline_override": {
                        "RegionalCombatOptScope": {
                            "attach": {
                                "scope": "all_cities"
                            }
                        }
                    }
                },
                {
                    "name": "CurrentCity",
                    "label": "仅推进当前选中的车站",
                    "pipeline_override": {
                        "RegionalCombatOptScope": {
                            "attach": {
                                "scope": "current_city"
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatCityOrder": {
            "type": "select",
            "label": "车站推进顺序",
            "description": "首次进入会扫描车站列表并依据各站等级跨度估算总关卡数，默认先清 10~25 关短站点，再推阿妮塔战备工厂与铁盟哨站等长站点。",
            "default_case": "FewestStagesFirst",
            "cases": [
                {
                    "name": "FewestStagesFirst",
                    "label": "低关卡数优先（先清 10~25 关短站点，推荐）",
                    "pipeline_override": {
                        "RegionalCombatOptCityOrder": {
                            "attach": {
                                "city_order": "fewest_stages_first"
                            }
                        }
                    }
                },
                {
                    "name": "ListOrder",
                    "label": "按列表从上到下顺序",
                    "pipeline_override": {
                        "RegionalCombatOptCityOrder": {
                            "attach": {
                                "city_order": "list_order"
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatMaxEnemyLevel": {
            "type": "select",
            "label": "敌方等级上限",
            "description": "遇到高于设定敌方等级的未通关关卡时自动跳过该车站（或停机）；注意未开启战败检查时遇到低练度高难关也会在战败后自动停机。",
            "default_case": "Unlimited",
            "cases": [
                {
                    "name": "Unlimited",
                    "label": "不限制（推荐，打不过战败即停）",
                    "pipeline_override": {
                        "RegionalCombatOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 0,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv50",
                    "label": "≤ 50 级",
                    "pipeline_override": {
                        "RegionalCombatOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 50,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv60",
                    "label": "≤ 60 级",
                    "pipeline_override": {
                        "RegionalCombatOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 60,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv70",
                    "label": "≤ 70 级",
                    "pipeline_override": {
                        "RegionalCombatOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 70,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv80",
                    "label": "≤ 80 级",
                    "pipeline_override": {
                        "RegionalCombatOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 80,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Custom",
                    "label": "自定义敌方等级上限",
                    "option": [
                        "RegionalCombatCustomMaxEnemyLevel"
                    ],
                    "pipeline_override": {
                        "RegionalCombatOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 0,
                                "use_custom_max_enemy_level": true
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatCustomMaxEnemyLevel": {
            "type": "input",
            "label": "自定义敌方等级上限",
            "inputs": [
                {
                    "name": "custom_max_enemy_level",
                    "label": "最高敌方等级",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入大于 0 的整数。"
                }
            ],
            "pipeline_override": {
                "RegionalCombatOptCustomMaxEnemyLevel": {
                    "attach": {
                        "custom_max_enemy_level": "{custom_max_enemy_level}"
                    }
                }
            }
        },
        "RegionalCombatMaxRuns": {
            "type": "select",
            "label": "推关次数上限",
            "description": "默认不限次直到体力耗尽、全部通关或超出等级上限。",
            "default_case": "Unlimited",
            "cases": [
                {
                    "name": "Unlimited",
                    "label": "不限制（清完当前澄明度 / 全部可打新关）",
                    "pipeline_override": {
                        "RegionalCombatOptRunMode": {
                            "attach": {
                                "run_mode": "unlimited"
                            }
                        }
                    }
                },
                {
                    "name": "FixedCount",
                    "label": "指定推关次数",
                    "option": [
                        "RegionalCombatRunCount"
                    ],
                    "pipeline_override": {
                        "RegionalCombatOptRunMode": {
                            "attach": {
                                "run_mode": "fixed_count"
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatRunCount": {
            "type": "input",
            "label": "指定推关次数",
            "inputs": [
                {
                    "name": "run_count",
                    "label": "次数",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入大于 0 的整数。"
                }
            ],
            "pipeline_override": {
                "RegionalCombatOptRunCount": {
                    "attach": {
                        "run_count": "{run_count}"
                    }
                }
            }
        },
        "RegionalCombatUseClarityMedicine": {
            "type": "switch",
            "label": "使用体力药/桦石",
            "description": "开启后才会显示下方使用次数；关闭时遇到澄明度不足将自动点击取消并结束任务。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "RegionalCombatClarityRecovery": {
                            "enabled": false
                        },
                        "RegionalCombatOptUseMedicine": {
                            "attach": {
                                "use_medicine": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "option": [
                        "RegionalCombatClarityLimits"
                    ],
                    "pipeline_override": {
                        "RegionalCombatClarityRecovery": {
                            "enabled": true
                        },
                        "RegionalCombatOptUseMedicine": {
                            "attach": {
                                "use_medicine": true
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatClarityLimits": {
            "type": "input",
            "label": "区域作战中心体力药/桦石使用次数",
            "description": "本轮任务每成功使用 1 次会扣减可用配额；-1 不限次，0 表示禁用该恢复手段。",
            "inputs": [
                {
                    "name": "lollipop_use_limit",
                    "label": "仙人掌能量棒棒糖使用次数",
                    "description": "-1 为无限制，0 为不使用，正数为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|0|[1-9]\\d*)$",
                    "pattern_msg": "请输入 -1、0 或正整数。"
                },
                {
                    "name": "roll_use_limit",
                    "label": "仙人掌跳跳卷使用次数",
                    "description": "-1 为无限制，0 为不使用，正数为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|0|[1-9]\\d*)$",
                    "pattern_msg": "请输入 -1、0 或正整数。"
                },
                {
                    "name": "candy_use_limit",
                    "label": "仙人掌能量跳糖使用次数",
                    "description": "-1 为无限制，0 为不使用，正数为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|0|[1-9]\\d*)$",
                    "pattern_msg": "请输入 -1、0 或正整数。"
                },
                {
                    "name": "huashi_use_limit",
                    "label": "桦石使用次数（最高 8）",
                    "description": "-1 为无限制，0 为不使用，1-8 为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|[0-8])$",
                    "pattern_msg": "请输入 -1 或 0-8。"
                }
            ],
            "pipeline_override": {
                "RegionalCombatClarityRecovery": {
                    "custom_action_param": {
                        "lollipop_use_limit": "{lollipop_use_limit}",
                        "roll_use_limit": "{roll_use_limit}",
                        "candy_use_limit": "{candy_use_limit}",
                        "huashi_use_limit": "{huashi_use_limit}"
                    }
                }
            }
        },
        "RegionalCombatFormationMode": {
            "type": "select",
            "label": "编队自动选人",
            "default_case": "Off",
            "cases": [
                {
                    "name": "Off",
                    "label": "不自动改编队（直接点开始作战）",
                    "pipeline_override": {
                        "RegionalCombatFormationEmpty": {
                            "enabled": false
                        },
                        "RegionalCombatFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "EmptyOnly",
                    "label": "仅存在空位时补齐（保留现有/手动配队）",
                    "option": [
                        "RegionalCombatFormationRoles"
                    ],
                    "pipeline_override": {
                        "RegionalCombatFormationEmpty": {
                            "enabled": true
                        },
                        "RegionalCombatFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Strict",
                    "label": "严格按名单自动编队",
                    "option": [
                        "RegionalCombatFormationRoles"
                    ],
                    "pipeline_override": {
                        "RegionalCombatFormationEmpty": {
                            "enabled": false
                        },
                        "RegionalCombatFormationStrict": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "RegionalCombatFormationRoles": {
            "type": "input",
            "label": "编队目标角色名单",
            "description": "按优先级填写角色全名，逗号或顿号分隔；留空则保持当前阵容不调整。",
            "inputs": [
                {
                    "name": "target_roles",
                    "label": "目标名单",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "RegionalCombatFormationQuickSelect": {
                    "custom_action_param": {
                        "target_roles": "{target_roles}",
                        "max_team_size": 5
                    }
                },
                "RegionalCombatFormationEmpty": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": false
                    }
                },
                "RegionalCombatFormationStrict": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": true
                    }
                }
            }
        },
        "RegionalCombatBattlePlayMode": {
            "type": "select",
            "label": "手牌出牌模式",
            "description": "当关卡原生自动未开启或不可用时接管手牌。",
            "default_case": "FastRush",
            "cases": [
                {
                    "name": "FastRush",
                    "label": "快斩模式（大招就绪秒放 + 随机极速甩牌）",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptPlayMode": {
                            "attach": {
                                "play_mode": "fast_rush"
                            }
                        }
                    }
                },
                {
                    "name": "Weighted",
                    "label": "权重模式（实验原型·尚未完善，几乎不可用）",
                    "option": [
                        "RegionalCombatMinCost"
                    ],
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptPlayMode": {
                            "attach": {
                                "play_mode": "weighted"
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatPreferNativeAuto": {
            "type": "switch",
            "label": "优先启用原生自动战斗",
            "description": "开启后，支持原生自动的关卡将自动开启游戏原生自动并等待结束；关闭则改由手牌识别出牌。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": false
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatLeaderSkill": {
            "type": "switch",
            "label": "手牌接管时优先释放队长技",
            "description": "开启后，手牌接管阶段将在队长得意技就绪时自动拖放释放。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": false
                            }
                        }
                    }
                }
            ]
        },
        "RegionalCombatMinCost": {
            "type": "select",
            "label": "权重模式最低费用门槛",
            "default_case": "Cost2",
            "cases": [
                {
                    "name": "Cost0",
                    "label": "0 费起出（有牌即出）",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 0
                            }
                        }
                    }
                },
                {
                    "name": "Cost2",
                    "label": "2 费起出（推荐）",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 2
                            }
                        }
                    }
                },
                {
                    "name": "Cost4",
                    "label": "4 费起出（蓄费）",
                    "pipeline_override": {
                        "RegionalCombatBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 4
                            }
                        }
                    }
                }
            ]
        }
    }
}
