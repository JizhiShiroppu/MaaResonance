{
    "task": [
        {
            "name": "AutoBattle",
            "label": "自动作战（手牌接管）",
            "entry": "AutoBattleEntry",
            "description": "在主线等禁用内置自动战斗的关卡中接管手牌拖拽出牌与队长得意技释放（已预留卡牌权重、禁用名单与目标区域配置接口）。",
            "group": [
                "experimental"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "AutoBattleFromFormation",
                "AutoBattlePlayMode",
                "AutoBattlePreferNativeAuto",
                "AutoBattleAutoSettle",
                "AutoBattleLeaderSkill"
            ]
        }
    ],
    "option": {
        "AutoBattleFromFormation": {
            "type": "switch",
            "label": "从编队界面自动点开始作战",
            "description": "开启后会先点击编队右侧“开始作战”，加载进入战斗后再接管；默认关闭以免误耗体力。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoBattleEntry": {
                            "next": [
                                "AutoBattleStart"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoBattleEntry": {
                            "next": [
                                "AutoBattleStart",
                                "AutoBattleEnterFromFormation"
                            ]
                        }
                    }
                }
            ]
        },
        "AutoBattlePlayMode": {
            "type": "select",
            "label": "手牌出牌模式",
            "default_case": "FastRush",
            "cases": [
                {
                    "name": "FastRush",
                    "label": "快斩模式（大招就绪秒放 + 随机极速甩牌）",
                    "pipeline_override": {
                        "AutoBattleStartOptPlayMode": {
                            "attach": {
                                "play_mode": "fast_rush"
                            }
                        }
                    }
                },
                {
                    "name": "Weighted",
                    "label": "权重模式（实验原型·尚未完善，几乎不可用）",
                    "option": [
                        "AutoBattleMinCost"
                    ],
                    "pipeline_override": {
                        "AutoBattleStartOptPlayMode": {
                            "attach": {
                                "play_mode": "weighted"
                            }
                        }
                    }
                }
            ]
        },
        "AutoBattlePreferNativeAuto": {
            "type": "switch",
            "label": "优先启用原生自动战斗",
            "description": "支持原生自动战斗的关卡优先点击开启游戏自动按钮并仅等待结算；主线禁用原生自动的关卡再接管手牌拖拽。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoBattleStartOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoBattleStartOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": false
                            }
                        }
                    }
                }
            ]
        },
        "AutoBattleAutoSettle": {
            "type": "switch",
            "label": "战后自动跳过剧情与点击结算",
            "description": "开启后会等待战后结算界面（若游戏已自动退出到大地图/行车界面则直接收工，不重复点击）；关闭则在战斗结束时即停止。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoBattleStart": {
                            "next": [
                                "AutoBattleSettlementPoll01"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoBattleStart": {
                            "next": [
                                "AutoBattleSkipSettleDone"
                            ]
                        }
                    }
                }
            ]
        },
        "AutoBattleLeaderSkill": {
            "type": "switch",
            "label": "手牌接管时优先释放队长技",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoBattleStartOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoBattleStartOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": false
                            }
                        }
                    }
                }
            ]
        },
        "AutoBattleMinCost": {
            "type": "select",
            "label": "权重模式最低费用门槛",
            "default_case": "Cost2",
            "cases": [
                {
                    "name": "Cost0",
                    "label": "0 费起出（有牌即出）",
                    "pipeline_override": {
                        "AutoBattleStartOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 0
                            }
                        }
                    }
                },
                {
                    "name": "Cost2",
                    "label": "2 费起出（推荐）",
                    "pipeline_override": {
                        "AutoBattleStartOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 2
                            }
                        }
                    }
                },
                {
                    "name": "Cost4",
                    "label": "4 费起出（蓄费）",
                    "pipeline_override": {
                        "AutoBattleStartOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 4
                            }
                        }
                    }
                }
            ]
        }
    }
}
