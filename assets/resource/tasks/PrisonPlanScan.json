        "PrisonPlanProdDuration": {
            "type": "select",
            "label": "生产车间排产时长偏好",
            "description": "启动生产车间白名单配方时，优先尝试的挂机时长档位；若当前材料不够该档，会自动向下回退（如 8小时 -> 4小时 -> 2小时）。",
            "default_case": "Prefer8h",
            "cases": [
                {
                    "name": "Prefer8h",
                    "label": "8 小时优先（适合日常长挂机，不够自动降档，推荐）",
                    "pipeline_override": {
                        "PrisonPlanOptProdDuration": {
                            "attach": {
                                "prod_duration_pref": "8h"
                            }
                        }
                    }
