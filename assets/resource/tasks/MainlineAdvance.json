{
    "task": [
        {
            "name": "MainlineAdvance",
            "label": "主线自动推进",
            "entry": "MainlineAdvanceLoop",
            "description": "自动识别城内主线任务标记并点击左下角头像、在大厅进站或启程、在大地图点击导航至主线任务车站并前往目的地，并串联剧情跳过、自动编队、主线战斗与战后结算。",
            "group": [
                "mainline"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "MainlineUseClarityMedicine",
                "MainlineStoryChoice",
                "MainlineFormationMode",
                "MainlineBattlePlayMode",
                "MainlinePreferNativeAuto",
                "MainlineLeaderSkill"
            ]
        }
    ],
    "option": {
        "MainlineUseClarityMedicine": {
            "type": "switch",
            "label": "使用体力药/桦石",
            "description": "开启后才会显示下方使用次数。次数含义：-1 为无限制，0 为不使用，正数为本轮剩余可用次数；桦石最高 8 次。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MainlineClarityRecovery": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "option": [
                        "MainlineClarityLimits"
                    ],
                    "pipeline_override": {
                        "MainlineClarityRecovery": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "MainlineClarityLimits": {
            "type": "input",
            "label": "主线体力药/桦石使用次数",
            "description": "本轮任务每成功使用 1 次会扣减可用配额；-1 不限次，0 表示禁用该恢复手段。",
            "inputs": [
                {
                    "name": "lollipop_use_limit",
                    "label": "仙人掌能量棒棒糖使用次数",
                    "description": "-1 为无限制，0 为不使用，正数为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|0|[1-9]\\d*)$",
                    "pattern_msg": "请输入 -1、0 或正整数。"
                },
                {
                    "name": "roll_use_limit",
                    "label": "仙人掌跳跳卷使用次数",
                    "description": "-1 为无限制，0 为不使用，正数为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|0|[1-9]\\d*)$",
                    "pattern_msg": "请输入 -1、0 或正整数。"
                },
                {
                    "name": "candy_use_limit",
                    "label": "仙人掌能量跳糖使用次数",
                    "description": "-1 为无限制，0 为不使用，正数为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|0|[1-9]\\d*)$",
                    "pattern_msg": "请输入 -1、0 或正整数。"
                },
                {
                    "name": "huashi_use_limit",
                    "label": "桦石使用次数（最高 8）",
                    "description": "-1 为无限制，0 为不使用，1-8 为本轮可用次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(-1|[0-8])$",
                    "pattern_msg": "请输入 -1 或 0-8。"
                }
            ],
            "pipeline_override": {
                "MainlineClarityRecovery": {
                    "custom_action_param": {
                        "lollipop_use_limit": "{lollipop_use_limit}",
                        "roll_use_limit": "{roll_use_limit}",
                        "candy_use_limit": "{candy_use_limit}",
                        "huashi_use_limit": "{huashi_use_limit}"
                    }
                }
            }
        },
        "MainlineStoryChoice": {
            "type": "select",
            "label": "剧情跳过分支策略",
            "default_case": "First",
            "cases": [
                {
                    "name": "First",
                    "label": "自动跳过（分支选第一项）",
                    "pipeline_override": {
                        "MainlineStorySkip": {
                            "enabled": true,
                            "custom_action_param": {
                                "choice_index": 0,
                                "max_steps": 120
                            }
                        }
                    }
                },
                {
                    "name": "Last",
                    "label": "自动跳过（分支选最后一项）",
                    "pipeline_override": {
                        "MainlineStorySkip": {
                            "enabled": true,
                            "custom_action_param": {
                                "choice_index": 99,
                                "max_steps": 120
                            }
                        }
                    }
                },
                {
                    "name": "Off",
                    "label": "关闭剧情跳过",
                    "pipeline_override": {
                        "MainlineStorySkip": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "MainlineFormationMode": {
            "type": "select",
            "label": "编队自动选人",
            "default_case": "Off",
            "cases": [
                {
                    "name": "Off",
                    "label": "不自动改编队（直接开战）",
                    "pipeline_override": {
                        "MainlineFormationEmpty": {
                            "enabled": false
                        },
                        "MainlineFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "EmptyOnly",
                    "label": "仅存在空位时补齐（保留剧情/手动配队）",
                    "option": [
                        "MainlineFormationRoles"
                    ],
                    "pipeline_override": {
                        "MainlineFormationEmpty": {
                            "enabled": true
                        },
                        "MainlineFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Strict",
                    "label": "严格按名单自动编队",
                    "option": [
                        "MainlineFormationRoles"
                    ],
                    "pipeline_override": {
                        "MainlineFormationEmpty": {
                            "enabled": false
                        },
                        "MainlineFormationStrict": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "MainlineFormationRoles": {
            "type": "input",
            "label": "编队目标角色名单",
            "description": "按优先级填写角色全名，逗号或顿号分隔；留空则保持当前阵容不调整。",
            "inputs": [
                {
                    "name": "target_roles",
                    "label": "目标名单",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "MainlineFormationQuickSelect": {
                    "custom_action_param": {
                        "target_roles": "{target_roles}",
                        "max_team_size": 5
                    }
                },
                "MainlineFormationEmpty": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": false
                    }
                },
                "MainlineFormationStrict": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": true
                    }
                }
            }
        },
        "MainlineBattlePlayMode": {
            "type": "select",
            "label": "手牌出牌模式",
            "default_case": "FastRush",
            "cases": [
                {
                    "name": "FastRush",
                    "label": "快斩模式（大招就绪秒放 + 随机极速甩牌）",
                    "pipeline_override": {
                        "MainlineBattleAutoOptPlayMode": {
                            "attach": {
                                "play_mode": "fast_rush"
                            }
                        }
                    }
                },
                {
                    "name": "Weighted",
                    "label": "权重模式（实验原型·尚未完善，几乎不可用）",
                    "option": [
                        "MainlineMinCost"
                    ],
                    "pipeline_override": {
                        "MainlineBattleAutoOptPlayMode": {
                            "attach": {
                                "play_mode": "weighted"
                            }
                        }
                    }
                }
            ]
        },
        "MainlinePreferNativeAuto": {
            "type": "switch",
            "label": "优先启用原生自动战斗",
            "description": "开启后，普通关优先开启游戏原生自动并静默等待；主线禁自动关卡无缝接管手牌。关闭后始终使用手牌出牌。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MainlineBattleAutoOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "MainlineBattleAutoOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": false
                            }
                        }
                    }
                }
            ]
        },
        "MainlineLeaderSkill": {
            "type": "switch",
            "label": "手牌接管时优先释放队长技",
            "description": "开启后，手牌接管阶段将在队长得意技就绪时自动拖放释放。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MainlineBattleAutoOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "MainlineBattleAutoOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": false
                            }
                        }
                    }
                }
            ]
        },
        "MainlineMinCost": {
            "type": "select",
            "label": "权重模式最低费用门槛",
            "default_case": "Cost2",
            "cases": [
                {
                    "name": "Cost0",
                    "label": "0 费起出（有牌即出）",
                    "pipeline_override": {
                        "MainlineBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 0
                            }
                        }
                    }
                },
                {
                    "name": "Cost2",
                    "label": "2 费起出（推荐）",
                    "pipeline_override": {
                        "MainlineBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 2
                            }
                        }
                    }
                },
                {
                    "name": "Cost4",
                    "label": "4 费起出（蓄费）",
                    "pipeline_override": {
                        "MainlineBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 4
                            }
                        }
                    }
                }
            ]
        }
    }
}
