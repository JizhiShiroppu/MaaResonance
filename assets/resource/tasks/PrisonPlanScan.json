{
    "task": [
        {
            "name": "PrisonPlanScan",
            "label": "整顿中心（监狱）自动（实验型）",
            "entry": "PrisonPlanStart",
            "description": "整顿中心（监狱）专属自动管家（支持在任意城市通过左侧抽屉远程进入，也可接入一键自动日常）：先扫描整顿等级、建筑、双仓、商店工票与黑月订单，再按执行模式与 14 项细粒度模块开关安全处理「做什么 / 买什么 / 造什么」。全程受零桦石像素+OCR双护栏、可自定义铁盟币底线与 1/6/16/26/36/46 阶梯锁保护，并自动导出脱敏排错压缩包至 config/planning/logs/ 方便提交 Issue。",
            "group": [
                "daily",
                "account"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "PrisonPlanExecMode",
                "PrisonPlanReserveCoins",
                "PrisonPlanPlayerLevel",
                "PrisonPlanScanSubpages",
                "PrisonPlanHuashiStrategy",
                "PrisonPlanAutoOpenReport",
                "PrisonPlanDebugExport"
            ]
        }
    ],
    "option": {
        "PrisonPlanExecMode": {
            "type": "select",
            "label": "执行模式",
            "description": "默认在像素与金额双护栏下自动执行安全的黑月交单、研发/电力升级、左侧铁盟币扩仓、工票配方、原料预存与车间排产；可随时切回「仅只读扫描与规划」（切换后自动折叠下方执行细节项）。自动执行全程绝对不花桦石。",
            "default_case": "ExecuteSafeAuto",
            "cases": [
                {
                    "name": "ExecuteSafeAuto",
                    "label": "自动执行安全项（零桦石/保底线/阶梯护栏，推荐）",
                    "option": [
                        "PrisonPlanAutoScope",
                        "PrisonPlanProdDuration",
                        "PrisonPlanRawWorkerMode",
                        "PrisonPlanWarehouseBatchCap",
                        "PrisonPlanCoreUpgradeCap"
                    ],
                    "pipeline_override": {
                        "PrisonPlanOptExecMode": {
                            "attach": {
                                "exec_mode": "execute_safe_auto"
                            }
                        }
                    }
                },
                {
                    "name": "PlanOnly",
                    "label": "仅只读扫描与规划（零点击消费）",
                    "pipeline_override": {
                        "PrisonPlanOptExecMode": {
                            "attach": {
                                "exec_mode": "plan_only"
                            }
                        }
                    }
                }
            ]
        },
        "PrisonPlanAutoScope": {
            "type": "select",
            "label": "自动执行范围",
            "description": "当执行模式为「自动执行安全项」时生效；选择「自定义勾选子模块」可单独开关 14 项具体自动化动作。",
            "default_case": "FullSafe",
            "cases": [
                {
                    "name": "FullSafe",
                    "label": "全项安全托管（交单 + 升级 + 扩仓 + 配方 + 预存 + 排产）",
                    "pipeline_override": {
                        "PrisonPlanOptAutoScope": {
                            "attach": {
                                "auto_scope": "full_safe",
                                "modules_ui_configured": false
                            }
                        }
                    }
                },
                {
                    "name": "OrdersAndProdOnly",
                    "label": "仅做：领奖 + 入住 + 财务 + 交单 + 原料与车间排产",
                    "pipeline_override": {
                        "PrisonPlanOptAutoScope": {
                            "attach": {
                                "auto_scope": "orders_and_prod",
                                "modules_ui_configured": false
                            }
                        }
                    }
                },
                {
                    "name": "BuildAndBuyOnly",
                    "label": "仅建买：核心升级 + 左侧币扩仓 + 商店工票兑换",
                    "pipeline_override": {
                        "PrisonPlanOptAutoScope": {
                            "attach": {
                                "auto_scope": "build_and_buy",
                                "modules_ui_configured": false
                            }
                        }
                    }
                },
                {
                    "name": "Custom",
                    "label": "自定义勾选子模块（展开下方 14 项精细开关）",
                    "option": [
                        "PrisonPlanEnabledModules"
                    ],
                    "pipeline_override": {
                        "PrisonPlanOptAutoScope": {
                            "attach": {
                                "auto_scope": "custom",
                                "modules_ui_configured": true
                            }
                        }
                    }
                }
            ]
        },
