        "PrisonPlanHuashiStrategy": {
            "type": "select",
            "label": "桦石消费策略（仅作规划参考，自动执行永不花桦石）",
            "description": "二周年攻略建议电机与仓库桦石扩容全点满（满电机共 3,500 桦石）；无论选哪项，当前自动执行模式均会通过像素+OCR双重护栏硬锁电机页与仓库桦石页签，绝不消耗桦石。",
            "default_case": "ProtectAll",
            "cases": [
                {
                    "name": "ProtectAll",
                    "label": "全程保护桦石（默认推荐）",
                    "pipeline_override": {
                        "PrisonPlanOptHuashiStrategy": {
                            "attach": {
                                "allow_huashi_motors": false,
                                "allow_huashi_warehouse": false
                            }
                        }
                    }
                },
                {
                    "name": "MotorsOnly",
                    "label": "仅允许计划电力中心电机桦石",
                    "pipeline_override": {
                        "PrisonPlanOptHuashiStrategy": {
                            "attach": {
                                "allow_huashi_motors": true,
                                "allow_huashi_warehouse": false
                            }
                        }
                    }
                },
                {
                    "name": "MotorsAndWarehouse",
                    "label": "按攻略全开计划（电机 + 仓库桦石扩容）",
                    "pipeline_override": {
                        "PrisonPlanOptHuashiStrategy": {
                            "attach": {
                                "allow_huashi_motors": true,
                                "allow_huashi_warehouse": true
                            }
                        }
                    }
                }
            ]
        },
        "PrisonPlanPlayerLevel": {
            "type": "select",
            "label": "列车长等级档位（影响原料车间预存金额）",
            "description": "按二周年攻略建议：80 级前原料采集每次预存 50 万铁盟币，80 级及以后可按 250 万预存。",
            "default_case": "Under80",
            "cases": [
                {
                    "name": "Under80",
                    "label": "80 级以下（原料车间每次预存 50 万）",
                    "pipeline_override": {
                        "PrisonPlanOptPlayerLevel": {
                            "attach": {
                                "player_level": 71
                            }
                        }
                    }
                },
                {
                    "name": "Over80",
                    "label": "80 级及以上（原料车间每次预存 250 万）",
                    "pipeline_override": {
                        "PrisonPlanOptPlayerLevel": {
                            "attach": {
                                "player_level": 80
                            }
                        }
                    }
                }
            ]
        },
        "PrisonPlanAutoOpenReport": {
            "type": "switch",
            "label": "分析完成后自动在浏览器打开可视化报告",
            "description": "开启后会在分析结束时自动用默认浏览器打开离线 HTML 图表报告（全程不联网）；在每日一键日常队列中默认关闭以防打断挂机。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "PrisonPlanOptAutoOpenReport": {
                            "attach": {
                                "auto_open_report": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "PrisonPlanOptAutoOpenReport": {
                            "attach": {
                                "auto_open_report": false
                            }
                        }
                    }
                }
            ]
        },
        "PrisonPlanDebugExport": {
            "type": "select",
            "label": "专项排错日志与 Issue 压缩包导出",
            "description": "遇到多账号/不同分辨率异常或点偏问题时，自动将脱敏后的专项日志、JSON 状态与 Issue 模版打包到 config/planning/logs/（自动清理只留最近 10 份）；遇到护栏拦截或异常时还可选自动附带紧凑 PNG 现场截图。",
            "default_case": "LogAndBundle",
            "cases": [
                {
                    "name": "LogAndBundle",
                    "label": "开启专项日志 + 一键 Issue 压缩包（默认推荐，已脱敏）",
                    "pipeline_override": {
                        "PrisonPlanOptDebugExport": {
                            "attach": {
                                "diag_export_mode": "bundle"
                            }
                        }
                    }
                },
                {
                    "name": "BundleWithScreenshots",
                    "label": "开启压缩包并附带异常 / 拦截现场截图（排错最清晰）",
                    "pipeline_override": {
                        "PrisonPlanOptDebugExport": {
                            "attach": {
                                "diag_export_mode": "bundle_screenshots"
                            }
                        }
                    }
                },
                {
                    "name": "LogOnly",
                    "label": "仅导出纯文本专项日志（.log）",
                    "pipeline_override": {
                        "PrisonPlanOptDebugExport": {
                            "attach": {
                                "diag_export_mode": "log_only"
                            }
                        }
                    }
                },
                {
                    "name": "Off",
                    "label": "关闭专项诊断导出",
                    "pipeline_override": {
                        "PrisonPlanOptDebugExport": {
                            "attach": {
                                "diag_export_mode": "off"
                            }
                        }
                    }
                }
            ]
        }
    }
}
