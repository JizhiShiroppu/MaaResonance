{
    "interface_version": 2,
    "name": "MaaResonance",
    "label": "MaaResonance",
    "title": "MaaResonance Plus",
    "description": "基于 MaaFramework 的 Resonance 自动化辅助项目（社区衍生增强版）。",
    "contact": "Issues: https://github.com/JizhiShiroppu/MaaResonance/issues",
    "license": "AGPL-3.0-only",
    "welcome": "MaaResonance Plus 为基于 DaiMao204/MaaResonance 的社区衍生增强版（AGPL-3.0-only）。使用中遇到问题请附带 MXU 日志、任务配置和出错界面截图前往本仓库 Issues 反馈。",
    "github": "https://github.com/JizhiShiroppu/MaaResonance",
    "version": "v2.0.0-plus.1",
    "controller": [
        {
            "name": "ADB",
            "label": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "Win32",
            "label": "PC 客户端（前台）",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^雷索纳斯$",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "attach_resource_path": [
                "./resource/pc"
            ]
        },
        {
            "name": "Win32BackgroundWindowPos",
            "label": "PC 客户端（后台-移窗不抢鼠标）",
            "description": "不移动物理鼠标，点击或滑动时会短暂平移后台游戏窗口对齐光标（游戏窗口可被遮挡但不可最小化）。",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^雷索纳斯$",
                "screencap": "FramePool",
                "mouse": "PostMessageWithWindowPos",
                "keyboard": "PostMessage"
            },
            "attach_resource_path": [
                "./resource/pc"
            ]
        },
        {
            "name": "Win32BackgroundCursorPos",
            "label": "PC 客户端（后台-移光标）",
            "description": "游戏窗口保持原位不动，点击或滑动瞬间短暂借用并复位物理鼠标（游戏窗口可被遮挡但不可最小化）。",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "^UnityWndClass$",
                "window_regex": "^雷索纳斯$",
                "screencap": "FramePool",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessage"
            },
            "attach_resource_path": [
                "./resource/pc"
            ]
        }
    ],
    "resource": [
        {
            "name": "official",
            "label": "官服",
            "path": [
                "./resource/base"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "identifier": "maa_resonance_agent",
        "child_args": [
            "-u",
            "../agent/main.py"
        ]
    },
    "group": [
        {
            "name": "account",
            "label": "账号配置"
        },
        {
            "name": "trade",
            "label": "跑商"
        },
        {
            "name": "combat",
            "label": "战斗"
        },
        {
            "name": "assist",
            "label": "辅助守护"
        },
        {
            "name": "mainline",
            "label": "主线"
        },
        {
            "name": "daily",
            "label": "日常"
        },
        {
            "name": "experimental",
            "label": "实验与原子工具"
        },
        {
            "name": "system",
            "label": "系统"
        }
    ],
    "task": [],
    "global_option": [
        "NetworkReconnectGuard"
    ],
    "option": {
        "NetworkReconnectGuard": {
            "type": "switch",
            "label": "断线弹窗自动重连守卫（全局）",
            "description": "默认关闭。开启后在截图巡检与各任务主循环中自动识别「当前网络不佳，请尝试重新连接」弹窗并点击确认重试；短期内达上限后，安卓模拟器暂停任务并大退重启至大厅续跑，PC 端不杀进程仅弹窗提醒并停止当前任务。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "CommonNetworkPoorGuard": {
                            "enabled": false
                        },
                        "CommonNetworkGuardConfig": {
                            "attach": {
                                "enabled": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "option": [
                        "NetworkReconnectRetryLimit",
                        "NetworkReconnectAdbAutoRestart",
                        "NetworkReconnectPcAlert"
                    ],
                    "pipeline_override": {
                        "CommonNetworkPoorGuard": {
                            "enabled": true
                        },
                        "CommonNetworkGuardConfig": {
                            "attach": {
                                "enabled": true
                            }
                        }
                    }
                }
            ]
        },
        "NetworkReconnectRetryLimit": {
            "type": "select",
            "label": "120 秒内弹窗重试上限",
            "description": "在 120 秒滑动窗口内连续/累计检测到网络不佳弹窗的确认重试次数，达到上限即触发大退重启（ADB）或停机提醒（PC）。",
            "default_case": "retry_10",
            "cases": [
                {
                    "name": "retry_5",
                    "label": "短期内 5 次",
                    "pipeline_override": {
                        "CommonNetworkGuardOptRetryLimit": {
                            "attach": {
                                "max_retries": 5,
                                "window_sec": 120.0
                            }
                        }
                    }
                },
                {
                    "name": "retry_10",
                    "label": "短期内 10 次（推荐）",
                    "pipeline_override": {
                        "CommonNetworkGuardOptRetryLimit": {
                            "attach": {
                                "max_retries": 10,
                                "window_sec": 120.0
                            }
                        }
                    }
                },
                {
                    "name": "retry_15",
                    "label": "短期内 15 次",
                    "pipeline_override": {
                        "CommonNetworkGuardOptRetryLimit": {
                            "attach": {
                                "max_retries": 15,
                                "window_sec": 120.0
                            }
                        }
                    }
                }
            ]
        },
        "NetworkReconnectAdbAutoRestart": {
            "type": "switch",
            "label": "ADB 满重试后大退重启至大厅续跑",
            "description": "仅对安卓模拟器生效：重试达上限时暂停当前任务，强制关闭并重启《雷索纳斯》，自动通过登录弹窗回到列车大厅后再恢复执行。",
            "controller": [
                "ADB"
            ],
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CommonNetworkGuardOptAdbRestart": {
                            "attach": {
                                "adb_auto_restart": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CommonNetworkGuardOptAdbRestart": {
                            "attach": {
                                "adb_auto_restart": false
                            }
                        }
                    }
                }
            ]
        },
        "NetworkReconnectPcAlert": {
            "type": "switch",
            "label": "PC 满重试后弹窗提醒并停机",
            "description": "仅对 PC 客户端生效：不主动结束游戏进程，重试达上限后弹出置顶提醒对话框并停止当前任务。",
            "controller": [
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CommonNetworkGuardOptPcAlert": {
                            "attach": {
                                "pc_popup_alert": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CommonNetworkGuardOptPcAlert": {
                            "attach": {
                                "pc_popup_alert": false
                            }
                        }
                    }
                }
            ]
        }
    },
    "preset": [
        {
            "name": "daily-all-in-one",
            "label": "一键自动日常",
            "description": "拆分为独立可勾选、可调顺序的完整日常流程：开始唤醒 -> 前置收菜与签到 -> 自动商店采购 -> 共斗众志攻坚 -> 限时活动刷关清澄明度 -> 糖霜记忆每日取景 -> [可选]铁安局 / 区域作战中心 / 虚演刻录 / 自动跑商 -> 每日活跃与通行证收尾领奖。",
