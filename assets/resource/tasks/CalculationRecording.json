{
    "task": [
        {
            "name": "CalculationRecording",
            "label": "虚演刻录自动作战",
            "entry": "CalculationRecordingLoop",
            "description": "自动从列车大厅经「活动中心 -> 常规活动 -> 虚演刻录 -> 前往虚演空间」进入（也可直接停在虚演刻录界面），默认扫描已解锁 Boss 并优先攻克敌方等级较低的未满 100% 关卡；打赢但未达成 S 级评级时自动跳过该 Boss，支持敌方等级上限避让、限次推关与门票耗尽安全结束。",
            "group": [
                "combat"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "CalculationRecordingAutoEnterHub",
                "CalculationRecordingScope",
                "CalculationRecordingMaxEnemyLevel",
                "CalculationRecordingMaxRuns",
                "CalculationRecordingFormationMode",
                "CalculationRecordingBattlePlayMode",
                "CalculationRecordingPreferNativeAuto",
                "CalculationRecordingLeaderSkill"
            ]
        }
    ],
    "option": {
        "CalculationRecordingAutoEnterHub": {
            "type": "switch",
            "label": "自动从列车大厅进入虚演刻录",
            "description": "开启后（全自动推荐），若停在列车大厅或活动中心，会自动进入「常规活动 -> 虚演刻录 -> 左侧前往虚演空间」再开始推关；关闭则仅在当前虚演刻录界面内运行。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CalculationRecordingLobbyEnterActivity": {
                            "enabled": true
                        },
                        "CalculationRecordingActivityHubSwitch": {
                            "enabled": true
                        },
                        "CalculationRecordingHubEnter": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CalculationRecordingLobbyEnterActivity": {
                            "enabled": false
                        },
                        "CalculationRecordingActivityHubSwitch": {
                            "enabled": false
                        },
                        "CalculationRecordingHubEnter": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "CalculationRecordingScope": {
            "type": "select",
            "label": "Boss 推进范围",
            "description": "决定推完或跳过当前 Boss 后的处理方式。",
            "default_case": "AllBosses",
            "cases": [
                {
                    "name": "AllBosses",
                    "label": "全已解锁 Boss 自动推进（跳过 100% / 未达 S 级 / 超等级上限 Boss）",
                    "option": [
                        "CalculationRecordingBossOrder"
                    ],
                    "pipeline_override": {
                        "CalculationRecordingOptScope": {
                            "attach": {
                                "scope": "all_bosses"
                            }
                        }
                    }
                },
                {
                    "name": "CurrentBoss",
                    "label": "仅推进当前选中的 Boss",
                    "pipeline_override": {
                        "CalculationRecordingOptScope": {
                            "attach": {
                                "scope": "current_boss"
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingBossOrder": {
            "type": "select",
            "label": "Boss 推进顺序",
            "description": "默认首次进入会扫描全部已解锁 Boss，优先挑选当前敌方等级最低的未 100% Boss 推进；若一阶段 S 级通关后解锁后续新 Boss，也会自动纳入重排。",
            "default_case": "LowestLevelFirst",
            "cases": [
                {
                    "name": "LowestLevelFirst",
                    "label": "低敌方等级优先（先打低级阶段与新解锁低级关，推荐）",
                    "pipeline_override": {
                        "CalculationRecordingOptBossOrder": {
                            "attach": {
                                "boss_order": "lowest_level_first"
                            }
                        }
                    }
                },
                {
                    "name": "ListOrder",
                    "label": "按列表序号从上到下顺序",
                    "pipeline_override": {
                        "CalculationRecordingOptBossOrder": {
                            "attach": {
                                "boss_order": "list_order"
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingMaxEnemyLevel": {
            "type": "select",
            "label": "敌方等级上限",
            "description": "遇到高于设定敌人等级的阶段时自动跳过该 Boss（或停机）；战败时也会自动停止。",
            "default_case": "Unlimited",
            "cases": [
                {
                    "name": "Unlimited",
                    "label": "不限制（推荐，未达成 S 级自动跳过、战败即停）",
                    "pipeline_override": {
                        "CalculationRecordingOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 0,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv50",
                    "label": "≤ 50 级",
                    "pipeline_override": {
                        "CalculationRecordingOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 50,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv60",
                    "label": "≤ 60 级",
                    "pipeline_override": {
                        "CalculationRecordingOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 60,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv70",
                    "label": "≤ 70 级",
                    "pipeline_override": {
                        "CalculationRecordingOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 70,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Lv80",
                    "label": "≤ 80 级",
                    "pipeline_override": {
                        "CalculationRecordingOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 80,
                                "use_custom_max_enemy_level": false
                            }
                        }
                    }
                },
                {
                    "name": "Custom",
                    "label": "自定义敌方等级上限",
                    "option": [
                        "CalculationRecordingCustomMaxEnemyLevel"
                    ],
                    "pipeline_override": {
                        "CalculationRecordingOptMaxEnemyLevel": {
                            "attach": {
                                "max_enemy_level": 0,
                                "use_custom_max_enemy_level": true
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingCustomMaxEnemyLevel": {
            "type": "input",
            "label": "自定义敌方等级上限",
            "inputs": [
                {
                    "name": "custom_max_enemy_level",
                    "label": "最高敌人等级",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入大于 0 的整数。"
                }
            ],
            "pipeline_override": {
                "CalculationRecordingOptCustomMaxEnemyLevel": {
                    "attach": {
                        "custom_max_enemy_level": "{custom_max_enemy_level}"
                    }
                }
            }
        },
        "CalculationRecordingMaxRuns": {
            "type": "select",
            "label": "推关次数上限",
            "description": "默认不限次直到虚演门票耗尽、全部 Boss 满 100% 或已跳过全部可打目标。",
            "default_case": "Unlimited",
            "cases": [
                {
                    "name": "Unlimited",
                    "label": "不限制（推至门票耗尽或无可打目标）",
                    "pipeline_override": {
                        "CalculationRecordingOptRunMode": {
                            "attach": {
                                "run_mode": "unlimited"
                            }
                        }
                    }
                },
                {
                    "name": "FixedCount",
                    "label": "指定推关次数",
                    "option": [
                        "CalculationRecordingRunCount"
                    ],
                    "pipeline_override": {
                        "CalculationRecordingOptRunMode": {
                            "attach": {
                                "run_mode": "fixed_count"
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingRunCount": {
            "type": "input",
            "label": "指定推关次数",
            "inputs": [
                {
                    "name": "run_count",
                    "label": "次数",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入大于 0 的整数。"
                }
            ],
            "pipeline_override": {
                "CalculationRecordingOptRunCount": {
                    "attach": {
                        "run_count": "{run_count}"
                    }
                }
            }
        },
        "CalculationRecordingFormationMode": {
            "type": "select",
            "label": "编队自动选人",
            "default_case": "Off",
            "cases": [
                {
                    "name": "Off",
                    "label": "不自动改编队（直接点开始作战）",
                    "pipeline_override": {
                        "CalculationRecordingFormationEmpty": {
                            "enabled": false
                        },
                        "CalculationRecordingFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "EmptyOnly",
                    "label": "仅存在空位时补齐（保留现有/手动配队）",
                    "option": [
                        "CalculationRecordingFormationRoles"
                    ],
                    "pipeline_override": {
                        "CalculationRecordingFormationEmpty": {
                            "enabled": true
                        },
                        "CalculationRecordingFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Strict",
                    "label": "严格按名单自动编队",
                    "option": [
                        "CalculationRecordingFormationRoles"
                    ],
                    "pipeline_override": {
                        "CalculationRecordingFormationEmpty": {
                            "enabled": false
                        },
                        "CalculationRecordingFormationStrict": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "CalculationRecordingFormationRoles": {
            "type": "input",
            "label": "编队目标角色名单",
            "description": "按优先级填写角色全名，逗号或顿号分隔；留空则保持当前阵容不调整。",
            "inputs": [
                {
                    "name": "target_roles",
                    "label": "目标名单",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "CalculationRecordingFormationQuickSelect": {
                    "custom_action_param": {
                        "target_roles": "{target_roles}",
                        "max_team_size": 5
                    }
                },
                "CalculationRecordingFormationEmpty": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": false
                    }
                },
                "CalculationRecordingFormationStrict": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": true
                    }
                }
            }
        },
        "CalculationRecordingBattlePlayMode": {
            "type": "select",
            "label": "手牌出牌模式",
            "description": "当关卡原生自动未开启或不可用时接管手牌。",
            "default_case": "FastRush",
            "cases": [
                {
                    "name": "FastRush",
                    "label": "快斩模式（大招就绪秒放 + 随机极速甩牌）",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptPlayMode": {
                            "attach": {
                                "play_mode": "fast_rush"
                            }
                        }
                    }
                },
                {
                    "name": "Weighted",
                    "label": "权重模式（实验原型·尚未完善，几乎不可用）",
                    "option": [
                        "CalculationRecordingMinCost"
                    ],
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptPlayMode": {
                            "attach": {
                                "play_mode": "weighted"
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingPreferNativeAuto": {
            "type": "switch",
            "label": "优先启用原生自动战斗",
            "description": "开启后，支持原生自动的关卡将自动开启游戏原生自动并等待结束；关闭则改由手牌识别出牌。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": false
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingLeaderSkill": {
            "type": "switch",
            "label": "手牌接管时优先释放队长技",
            "description": "开启后，手牌接管阶段将在队长得意技就绪时自动拖放释放。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": false
                            }
                        }
                    }
                }
            ]
        },
        "CalculationRecordingMinCost": {
            "type": "select",
            "label": "权重模式最低费用门槛",
            "default_case": "Cost2",
            "cases": [
                {
                    "name": "Cost0",
                    "label": "0 费起出（有牌即出）",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 0
                            }
                        }
                    }
                },
                {
                    "name": "Cost2",
                    "label": "2 费起出（推荐）",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 2
                            }
                        }
                    }
                },
                {
                    "name": "Cost4",
                    "label": "4 费起出（蓄费）",
                    "pipeline_override": {
                        "CalculationRecordingBattleAutoOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 4
                            }
                        }
                    }
                }
            ]
        }
    }
}
