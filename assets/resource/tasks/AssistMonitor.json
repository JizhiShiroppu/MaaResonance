{
    "task": [
        {
            "name": "AssistMonitor",
            "label": "辅助循环守护（开关版）",
            "entry": "AssistMonitorLoop",
            "description": "长期循环扫描屏幕，按开启的独立开关自动处理剧情跳过、编队选人、战斗出牌与结算；未命中时静默守望，不干扰手动操作，完全解耦于启动与跑商流程。",
            "group": [
                "assist"
            ],
            "resource": [
                "official"
            ],
            "controller": [
                "ADB",
                "Win32",
                "Win32BackgroundWindowPos",
                "Win32BackgroundCursorPos"
            ],
            "option": [
                "AssistMonitorStorySkip",
                "AssistMonitorFormation",
                "AssistMonitorBattle",
                "AssistMonitorAutoSettle"
            ]
        }
    ],
    "option": {
        "AssistMonitorStorySkip": {
            "type": "select",
            "label": "自动跳过剧情",
            "default_case": "First",
            "cases": [
                {
                    "name": "First",
                    "label": "开启（分支选第一项）",
                    "pipeline_override": {
                        "AssistBranchStory": {
                            "enabled": true,
                            "custom_action_param": {
                                "choice_index": 0,
                                "max_steps": 120
                            }
                        }
                    }
                },
                {
                    "name": "Last",
                    "label": "开启（分支选最后一项）",
                    "pipeline_override": {
                        "AssistBranchStory": {
                            "enabled": true,
                            "custom_action_param": {
                                "choice_index": 99,
                                "max_steps": 120
                            }
                        }
                    }
                },
                {
                    "name": "Off",
                    "label": "关闭",
                    "pipeline_override": {
                        "AssistBranchStory": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "AssistMonitorFormation": {
            "type": "select",
            "label": "编队自动选人",
            "default_case": "Off",
            "cases": [
                {
                    "name": "Off",
                    "label": "关闭",
                    "pipeline_override": {
                        "AssistBranchFormationEmpty": {
                            "enabled": false
                        },
                        "AssistBranchFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "EmptyOnly",
                    "label": "仅存在空位时补齐（不覆盖手动配队）",
                    "option": [
                        "AssistMonitorFormationRoles",
                        "AssistMonitorAutoStartBattle"
                    ],
                    "pipeline_override": {
                        "AssistBranchFormationEmpty": {
                            "enabled": true
                        },
                        "AssistBranchFormationStrict": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Strict",
                    "label": "严格按名单自动编队（不符即重选）",
                    "option": [
                        "AssistMonitorFormationRoles",
                        "AssistMonitorAutoStartBattle"
                    ],
                    "pipeline_override": {
                        "AssistBranchFormationEmpty": {
                            "enabled": false
                        },
                        "AssistBranchFormationStrict": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "AssistMonitorFormationRoles": {
            "type": "input",
            "label": "编队目标角色名单",
            "description": "按优先级填写角色全名，逗号或顿号分隔；留空则保持当前阵容不调整。",
            "inputs": [
                {
                    "name": "target_roles",
                    "label": "角色优先级顺序",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "AssistFormationQuickSelect": {
                    "custom_action_param": {
                        "target_roles": "{target_roles}",
                        "max_team_size": 5
                    }
                },
                "AssistBranchFormationEmpty": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": false
                    }
                },
                "AssistBranchFormationStrict": {
                    "custom_recognition_param": {
                        "target_roles": "{target_roles}",
                        "strict_match": true
                    }
                }
            }
        },
        "AssistMonitorAutoStartBattle": {
            "type": "switch",
            "label": "编队后自动点击开始作战",
            "description": "默认关闭，选完人留在编队页由你手动点击；开启后选完直接点开始作战。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "AssistFormationAutoStartBattle": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AssistFormationAutoStartBattle": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "AssistMonitorBattle": {
            "type": "switch",
            "label": "进入战斗自动接管",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "AssistMonitorPreferNativeAuto",
                        "AssistMonitorPlayMode",
                        "AssistMonitorLeaderSkill"
                    ],
                    "pipeline_override": {
                        "AssistBranchBattle": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AssistBranchBattle": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "AssistMonitorPlayMode": {
            "type": "select",
            "label": "手牌出牌模式",
            "default_case": "FastRush",
            "cases": [
                {
                    "name": "FastRush",
                    "label": "快斩模式（大招就绪秒放 + 随机极速甩牌）",
                    "pipeline_override": {
                        "AssistBranchBattleOptPlayMode": {
                            "attach": {
                                "play_mode": "fast_rush"
                            }
                        }
                    }
                },
                {
                    "name": "Weighted",
                    "label": "权重模式（实验原型·尚未完善，几乎不可用）",
                    "option": [
                        "AssistMonitorMinCost"
                    ],
                    "pipeline_override": {
                        "AssistBranchBattleOptPlayMode": {
                            "attach": {
                                "play_mode": "weighted"
                            }
                        }
                    }
                }
            ]
        },
        "AssistMonitorPreferNativeAuto": {
            "type": "switch",
            "label": "优先启用原生自动战斗",
            "description": "支持原生自动的关卡仅点击开启并静默等待；关闭则会主动关掉原生自动改由手牌识别出牌。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AssistBranchBattleOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AssistBranchBattleOptPreferNativeAuto": {
                            "attach": {
                                "prefer_native_auto": false
                            }
                        }
                    }
                }
            ]
        },
        "AssistMonitorAutoSettle": {
            "type": "switch",
            "label": "战后自动点击结算退出",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AssistBranchSettleMission": {
                            "enabled": true
                        },
                        "AssistBranchSettleNextTemplate": {
                            "enabled": true
                        },
                        "AssistBranchSettleNextOcr": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AssistBranchSettleMission": {
                            "enabled": false
                        },
                        "AssistBranchSettleNextTemplate": {
                            "enabled": false
                        },
                        "AssistBranchSettleNextOcr": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "AssistMonitorLeaderSkill": {
            "type": "switch",
            "label": "手牌接管时优先释放队长技",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AssistBranchBattleOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AssistBranchBattleOptLeaderSkill": {
                            "attach": {
                                "prefer_leader_skill": false
                            }
                        }
                    }
                }
            ]
        },
        "AssistMonitorMinCost": {
            "type": "select",
            "label": "权重模式最低费用门槛",
            "default_case": "Cost2",
            "cases": [
                {
                    "name": "Cost0",
                    "label": "0 费起出（有牌即出）",
                    "pipeline_override": {
                        "AssistBranchBattleOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 0
                            }
                        }
                    }
                },
                {
                    "name": "Cost2",
                    "label": "2 费起出（推荐）",
                    "pipeline_override": {
                        "AssistBranchBattleOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 2
                            }
                        }
                    }
                },
                {
                    "name": "Cost4",
                    "label": "4 费起出（蓄费）",
                    "pipeline_override": {
                        "AssistBranchBattleOptMinCost": {
                            "attach": {
                                "min_cost_to_play": 4
                            }
                        }
                    }
                }
            ]
        }
    }
}
